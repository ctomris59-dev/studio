NEXT_PUBLIC_SITE_URL=https://www.studiotasker.com
# LOCAL DEVELOPMENT ONLY; never upload real credentials or copy these passwords to a production host.
# Enable only behind a trusted proxy that overwrites X-Real-IP.
TRUST_PROXY_IP_HEADERS=false
# Run: docker compose up -d && npm run db:setup:local
DATABASE_URL=postgresql://reformdesk_app:reformdesk_dev_only@127.0.0.1:5432/reformdesk
MIGRATION_DATABASE_URL=postgresql://postgres:local_postgres_only@127.0.0.1:5432/reformdesk
# Registration is explicitly gated; leave off in publicly deployed environments.
AUTH_ALLOW_REGISTRATION=false

# Inert unless a trusted local/private environment explicitly enables registration.
PUBLIC_APP_ORIGIN=https://www.studiotasker.com
# AUTH_ALLOW_REGISTRATION=false (production default)
# SMTP required before real emails can be delivered. Worker remains disabled otherwise.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=support@studiotasker.com
# Paddle is the Merchant of Record for StudioTasker's SaaS subscription.
# Create SANDBOX credentials first. Never commit actual keys/tokens.
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_API_KEY=
# One-time catalog seeding: npm run paddle:seed:sandbox
# Creates StudioTasker + $39.90/month + $406.80/year in Paddle SANDBOX only.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Sandbox catalog IDs created for StudioTasker (non-secret; recreate separately for live).
# Monthly: $39.90/month
PADDLE_MONTHLY_PRICE_ID=pri_01m4b5gdnq7dyewwbagjv4m2f4
# Annual: $406.80/year
PADDLE_ANNUAL_PRICE_ID=pri_01m4b5gdrmcvj78yx4mt5ttjnh
PADDLE_WEBHOOK_SECRET=
# Allow signed Paddle sandbox events on a non-local staging site only when explicitly enabled.
BILLING_ALLOW_SANDBOX_TEST=false
PADDLE_SANDBOX_ALLOWED_ORIGIN=https://www.studiotasker.com
BILLING_ENFORCEMENT=off
# Manual commercial launch attestations. Keep false until the real checks have actually been completed.
LAUNCH_PADDLE_ACCOUNT_APPROVED=false
LAUNCH_LEGAL_REVIEW_CONFIRMED=false
LAUNCH_TAX_REVIEW_CONFIRMED=false
# Local-only integration bypass. Must be false in production.
BILLING_ALLOW_LOCAL_TEST=false
# For future encrypted offsite backups:
BACKUP_DATABASE_URL=
BACKUP_OUTPUT_DIR=
BACKUP_PASSPHRASE=
# RESTORE_DATABASE_URL and ALLOW_EMPTY_DATABASE_RESTORE are only for explicit restores.


# Legal identity and contract evidence. A company is NOT required by the application.
# For the current launch model StudioTasker is operated by an individual in Türkiye.
# Paid signup remains disabled until the individual operator and production providers are fully identified.
LEGAL_OPERATOR_TYPE=individual
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_COUNTRY=Türkiye
LEGAL_CONTACT_EMAIL=
LEGAL_SUPPORT_PHONE=
LEGAL_GOVERNING_LAW=
LEGAL_JURISDICTION=
LEGAL_HOSTING_PROVIDER=
# Production server purchased in an EU country; set the exact country/region when deployment is completed.
LEGAL_HOSTING_REGION=European Union (EU)
LEGAL_EMAIL_PROVIDER=
LEGAL_BILLING_PROVIDER=Paddle
# Long random secret used to HMAC-hash request IP evidence for contract acceptance.
LEGAL_AUDIT_HASH_KEY=
