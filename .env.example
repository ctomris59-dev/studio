# LOCAL DEVELOPMENT ONLY; never upload real credentials or copy these passwords to a production host.
# Run: docker compose up -d && npm run db:setup:local
DATABASE_URL=postgresql://reformdesk_app:reformdesk_dev_only@127.0.0.1:5432/reformdesk
MIGRATION_DATABASE_URL=postgresql://postgres:local_postgres_only@127.0.0.1:5432/reformdesk
# Registration is explicitly gated; leave off in publicly deployed environments.
AUTH_ALLOW_REGISTRATION=false
